# Supabase (local `npm run dev` may leave these blank for demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Prefer the new sb_secret_ key; never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Personal deployment defaults: authorize only these comma-separated addresses.
# Set ALLOW_PUBLIC_SIGNUP=true only if you intentionally want open registration.
ALLOW_PUBLIC_SIGNUP=false
AUTHORIZED_EMAILS=

# Server-side LLM evaluation (leave blank for the deterministic demo evaluator)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Applies to API-provider evaluations, including saved user settings. Set 0 to disable paid evaluations.
MAX_EVALUATIONS_PER_DAY=20
# Server-only encryption key for user-supplied LLM API keys: 32 random bytes, base64.
# Required with Supabase or in production. Local JSON development creates a private
# key beside its ignored data file. Keep this key stable and backed up privately.
LLM_SETTINGS_ENCRYPTION_KEY=

# Protects the scheduled automation endpoint
CRON_SECRET=

# Exact public origin used by confirmation and recovery links (no trailing path)
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Legacy-key compatibility (avoid for new Supabase projects):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
