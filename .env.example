# Supabase (leave blank to use the persistent local demo store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required only by the scheduled worker; never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side LLM evaluation (leave blank for the deterministic demo evaluator)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Protects the scheduled automation endpoint
CRON_SECRET=replace-with-a-long-random-value

# Public origin used by magic-link authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
